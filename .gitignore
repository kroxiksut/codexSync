# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE / editor files
.idea/
.vscode/

# OS files
.DS_Store
Thumbs.db

# Local runtime data (never commit)
logs/
backups/
sync/
state/
.tmp/
.tmp-build/
.codex-tmp/
.tmp-tests/
test-sandbox/
test-write-probe/

# Local machine-specific configs (keep only example template)
config.toml
config2.toml
config.local.toml

# Russian working documents (local planning notes, not part of the repository)
*.ru.md
CLAUDE.md
# Exception: user-facing translations are tracked (docs/ru/*.md never matches *.ru.md)
!README.ru.md

# Saved operation plans: local, machine-specific, and pinned to state bytes
sessions-plan.json
repair-plan.json
resolutions.json
